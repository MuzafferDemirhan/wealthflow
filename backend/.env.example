# Copy this file to .env and fill in your values
# Never commit .env to version control

# App
SECRET_KEY=your-super-secret-key-here
DEBUG=true

# Database - MS SQL Server 2022
# Install ODBC Driver 18 first: https://learn.microsoft.com/en-us/sql/connect/odbc/download-odbc-driver-for-sql-server
DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost:1433/wealthflow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Redis
REDIS_URL=redis://localhost:6379/0

# Enable Banking (https://enablebanking.com)
# 1. openssl genrsa -out private.key 4096
# 2. openssl req -new -x509 -days 365 -key private.key -out public.crt
# 3. Register app at https://enablebanking.com/cp/applications with the cert
# 4. Copy the app_id and private.key content below
ENABLE_BANKING_APP_ID=your-app-id
ENABLE_BANKING_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
