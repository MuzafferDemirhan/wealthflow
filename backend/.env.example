# Copy this file to .env and fill in your values
# Never commit .env to version control

# App
SECRET_KEY=your-super-secret-key-here
DEBUG=true

# Database
DATABASE_URL=postgresql://wealthflow:wealthflow@localhost:5432/wealthflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Plaid (get from https://dashboard.plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Anthropic Claude API (get from https://console.anthropic.com)
CLAUDE_API_KEY=your_claude_api_key

# Alpha Vantage (get from https://www.alphavantage.co)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
