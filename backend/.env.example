# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=WealthFlow
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (MS SQL Server 2022) ───────────────────────────────────────────────
# Install ODBC Driver 18 first:
# Windows/macOS/Linux: https://learn.microsoft.com/en-us/sql/connect/odbc/download-odbc-driver-for-sql-server
# Docker handles this automatically via docker-compose.yml
DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost:1433/wealthflow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Plaid (Open Banking) ────────────────────────────────────────────────────────
# Sign up at https://dashboard.plaid.com — sandbox is free, no approval needed
# PLAID_ENV options: sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US,GB,NL,PL

# ── Token Encryption ────────────────────────────────────────────────────────────
# Required — encrypts Plaid access tokens stored in the database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── AI Chatbot (Groq — free tier) ───────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
# Also compatible with OpenRouter, LocalAI, or any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Market Data (Alpha Vantage — free tier) ─────────────────────────────────────
# Get a free key at https://www.alphavantage.co/support/#api-key
# Used for portfolio real-time prices — optional, portfolio still works without it
ALPHA_VANTAGE_KEY=

# ── Export ──────────────────────────────────────────────────────────────────────
# Directory where PDF/CSV exports are stored (relative to backend/)
EXPORT_DIR=exports
