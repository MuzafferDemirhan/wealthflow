# Copy this file to .env and fill in your values
# Never commit .env to version control

# App
SECRET_KEY=your-super-secret-key-here
DEBUG=true

# Database — MS SQL Server 2022
# Install ODBC Driver 18 first: https://learn.microsoft.com/en-us/sql/connect/odbc/download-odbc-driver-for-sql-server
DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost:1433/wealthflow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Redis
REDIS_URL=redis://localhost:6379/0

# Nordigen / GoCardless Bank Account Data (https://bankaccountdata.gocardless.com)
NORDIGEN_SECRET_ID=your_nordigen_secret_id
NORDIGEN_SECRET_KEY=your_nordigen_secret_key

# Plaid (https://dashboard.plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Anthropic Claude API (https://console.anthropic.com)
CLAUDE_API_KEY=your_claude_api_key

# Alpha Vantage (https://www.alphavantage.co)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
