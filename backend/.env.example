# Copy this file to .env and fill in your values
# Never commit .env to version control

# App
SECRET_KEY=your-super-secret-key-here
DEBUG=true

# Database - MS SQL Server 2022
# Install ODBC Driver 18 first: https://learn.microsoft.com/en-us/sql/connect/odbc/download-odbc-driver-for-sql-server
DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost:1433/wealthflow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Redis
REDIS_URL=redis://localhost:6379/0

# Plaid (https://plaid.com)
# Get credentials at https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=["transactions"]
PLAID_COUNTRY_CODES=["US","GB","NL","PL"]

# Token encryption (used for Plaid access tokens at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LLM (Groq free tier: https://console.groq.com/keys)
# Uses OpenAI-compatible API — also works with OpenRouter, LocalAI, etc.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
